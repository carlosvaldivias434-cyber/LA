# BOT CREDENTIALS
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

# DATABASE
DATABASE_PATH=./database/larp.sqlite
SQLITE_WAL=true

# AI ENGINE INTEGRATIONS (GROQ & SAPLING)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AI_SUPPORT_ENABLED=true

# SAPLING AI WRITING DETECTOR (Screens staff application answers)
SAPLING_API_KEY=your_sapling_api_key_here
SAPLING_AI_DETECTION_ENABLED=true
SAPLING_FLAG_THRESHOLD=50

# LEAD DEVELOPER & BRANDING
BOT_DEVELOPER=Carlos473
BOT_NAME="Los Angeles Assistant AI"
BOT_TYPE="Assistant AI"
BOT_COLOR="#37373E"
BOT_FOOTER="Los Angeles Roleplay | Assistant AI | Coded by Carlos473"

